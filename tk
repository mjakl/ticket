#!/usr/bin/env bash
set -euo pipefail

# ticket - minimal ticket system with dependency tracking
# Stores markdown files with YAML frontmatter in .tickets/

# Find .tickets directory by walking parent directories
find_tickets_dir() {
    # Explicit env var takes priority
    [[ -n "${TICKETS_DIR:-}" ]] && { echo "$TICKETS_DIR"; return 0; }

    # Walk parents looking for .tickets
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.tickets" ]]; then
            echo "$dir/.tickets"
            return 0
        fi
        dir=$(dirname "$dir")
    done

    # Check root too
    [[ -d "/.tickets" ]] && { echo "/.tickets"; return 0; }

    # Not found
    return 1
}

# Commands that can create .tickets if not found
WRITE_COMMANDS="create"

# Initialize TICKETS_DIR based on command type
init_tickets_dir() {
    local cmd="$1"
    local is_write_cmd=0
    [[ " $WRITE_COMMANDS " == *" $cmd "* ]] && is_write_cmd=1

    if TICKETS_DIR=$(find_tickets_dir); then
        # For read commands, verify the directory exists
        if [[ $is_write_cmd -eq 0 ]] && [[ ! -d "$TICKETS_DIR" ]]; then
            echo "Error: tickets directory '$TICKETS_DIR' does not exist" >&2
            return 1
        fi
        return 0
    fi

    # Not found - write commands can initialize in current directory
    if [[ $is_write_cmd -eq 1 ]]; then
        TICKETS_DIR=".tickets"
        return 0
    fi

    echo "Error: no .tickets directory found (searched parent directories)" >&2
    echo "Run 'tk create' to initialize, or set TICKETS_DIR env var" >&2
    return 1
}

TICKET_PAGER="${TICKET_PAGER:-${PAGER:-}}"

# Prefer ripgrep if available, fall back to grep
if command -v rg &>/dev/null; then
    _grep() { rg "$@"; }
else
    _grep() { grep "$@"; }
fi

# Portable ISO date (GNU date supports -Iseconds, BSD date does not)
_iso_date() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

# Generate a random ticket ID
generate_id() {
    local hash
    hash=$(LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom | head -c 6)
    echo "$hash"
}

# Ensure tickets directory exists
ensure_dir() {
    mkdir -p "$TICKETS_DIR"
}

load_ticket_files() {
    shopt -s nullglob
    TICKET_FILES=("$TICKETS_DIR"/*.md)
    shopt -u nullglob
}

# Get ticket file path (supports partial ID matching)
ticket_path() {
    local id="$1"
    # Trim leading/trailing whitespace (handles Claude/agent quirks)
    read -r id <<< "$id"
    local exact="$TICKETS_DIR/${id}.md"

    if [[ -f "$exact" ]]; then
        echo "$exact"
        return 0
    fi

    # Try partial match (anywhere in filename)
    local matches
    matches=$(find "$TICKETS_DIR" -maxdepth 1 -name "*${id}*.md" 2>/dev/null | head -2)
    local count
    count=$(echo "$matches" | _grep -c . || true)

    if [[ "$count" -eq 1 ]]; then
        echo "$matches"
        return 0
    elif [[ "$count" -gt 1 ]]; then
        echo "Error: ambiguous ID '$id' matches multiple tickets" >&2
        return 1
    else
        echo "Error: ticket '$id' not found" >&2
        return 1
    fi
}

# Extract YAML field value
yaml_field() {
    local file="$1"
    local field="$2"
    awk -v field="$field" '
        NR == 1 && /^---$/ { in_front = 1; next }
        in_front && /^---$/ { exit }
        in_front && index($0, field ":") == 1 {
            sub("^[^:]+: *", "", $0)
            print
            exit
        }
    ' "$file"
}

# Update YAML field in frontmatter only
update_yaml_field() {
    local file="$1"
    local field="$2"
    local value="$3"
    local tmp="${file}.tmp.$$"

    awk -v field="$field" -v value="$value" '
        NR == 1 && /^---$/ {
            in_front = 1
            print
            next
        }
        in_front && /^---$/ {
            if (!updated) print field ": " value
            in_front = 0
            print
            next
        }
        in_front && index($0, field ":") == 1 {
            if (!updated) print field ": " value
            updated = 1
            next
        }
        { print }
    ' "$file" > "$tmp" && mv "$tmp" "$file"
}

array_contains() {
    local list="$1"
    local item="$2"
    local value

    list="${list#[}"
    list="${list%]}"
    list="${list// /}"
    [[ -z "$list" ]] && return 1

    local -a values
    IFS=',' read -r -a values <<< "$list"
    for value in "${values[@]}"; do
        [[ "$value" == "$item" ]] && return 0
    done
    return 1
}

array_append() {
    local list="$1"
    local item="$2"

    if [[ "$list" == "[]" || -z "${list// }" ]]; then
        echo "[$item]"
    else
        echo "${list%]}, $item]"
    fi
}

array_remove() {
    local list="$1"
    local item="$2"
    local value out=""

    list="${list#[}"
    list="${list%]}"
    list="${list// /}"
    [[ -z "$list" ]] && {
        echo "[]"
        return 0
    }

    local -a values
    IFS=',' read -r -a values <<< "$list"
    for value in "${values[@]}"; do
        [[ -z "$value" || "$value" == "$item" ]] && continue
        if [[ -z "$out" ]]; then
            out="$value"
        else
            out="$out, $value"
        fi
    done

    [[ -z "$out" ]] && echo "[]" || echo "[$out]"
}

ticket_references() {
    local target="$1"

    load_ticket_files
    [[ ${#TICKET_FILES[@]} -eq 0 ]] && return 0

    awk -v target="$target" '
        BEGIN { FS=": "; in_front=0 }
        FNR==1 {
            if (prev_file) store()
            id=""; parent=""; deps=""; in_front=0
            prev_file=FILENAME
        }
        FNR == 1 && /^---$/ { in_front = 1; next }
        in_front && /^---$/ { in_front = 0; next }
        in_front && /^id:/ { id = $2 }
        in_front && /^parent:/ { parent = $2 }
        in_front && /^deps:/ {
            deps = $2
            gsub(/[\[\] ]/, "", deps)
        }
        function store(    i, n, dep) {
            if (id == "") return
            if (parent == target) printf "parent:%s\n", id
            if (deps != "") {
                n = split(deps, arr, ",")
                for (i = 1; i <= n; i++) {
                    dep = arr[i]
                    if (dep == target) printf "dep:%s\n", id
                }
            }
        }
        END {
            if (prev_file) store()
        }
    ' "${TICKET_FILES[@]}" 2>/dev/null
}

format_references() {
    local refs="$1"
    local ref out=""

    while IFS= read -r ref; do
        [[ -z "$ref" ]] && continue
        case "$ref" in
            dep:*)
                [[ -n "$out" ]] && out+="; "
                out+="dependency of ${ref#dep:}"
                ;;
            parent:*)
                [[ -n "$out" ]] && out+="; "
                out+="parent of ${ref#parent:}"
                ;;
        esac
    done <<< "$refs"

    printf '%s' "$out"
}

require_option_value() {
    local option="$1"
    local value="${2:-}"

    if [[ -z "$value" ]]; then
        echo "Error: $option requires a value" >&2
        return 1
    fi

    case "$value" in
        -d|--description|-p|--priority|--parent)
            echo "Error: $option requires a value" >&2
            return 1
            ;;
    esac
}

validate_priority() {
    local priority="$1"
    [[ "$priority" =~ ^[0-4]$ ]] && return 0

    echo "Error: invalid priority '$priority'. Must be an integer from 0 to 4" >&2
    return 1
}

cmd_create() {
    ensure_dir

    local title="" description=""
    local priority=2 parent=""

    # Parse args
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--description)
                require_option_value "$1" "${2:-}" || return 1
                description="$2"
                shift 2
                ;;
            -p|--priority)
                require_option_value "$1" "${2:-}" || return 1
                priority="$2"
                shift 2
                ;;
            --parent)
                require_option_value "$1" "${2:-}" || return 1
                parent="$2"
                shift 2
                ;;
            -*) echo "Unknown option: $1" >&2; return 1 ;;
            *) title="$1"; shift ;;
        esac
    done

    validate_priority "$priority" || return 1

    # Validate and resolve parent if specified
    if [[ -n "$parent" ]]; then
        local parent_file
        parent_file=$(ticket_path "$parent") || return 1
        parent=$(basename "$parent_file" .md)
    fi

    title="${title:-Untitled}"
    local id file
    local attempts=0
    while true; do
        id=$(generate_id)
        file="$TICKETS_DIR/${id}.md"
        [[ ! -e "$file" ]] && break

        attempts=$((attempts + 1))
        if [[ $attempts -ge 100 ]]; then
            echo "Error: failed to generate a unique ticket ID after 100 attempts" >&2
            return 1
        fi
    done

    local now
    now=$(_iso_date)

    {
        echo "---"
        echo "id: $id"
        echo "status: open"
        echo "deps: []"
        echo "created: $now"
        echo "priority: $priority"
        [[ -n "$parent" ]] && echo "parent: $parent"
        echo "---"
        echo "# $title"
        echo ""
        if [[ -n "$description" ]]; then
            echo "$description"
            echo ""
        fi
    } > "$file"

    echo "$id"
}

# Valid statuses
VALID_STATUSES="open in_progress closed"

validate_status() {
    local status="$1"
    for valid in $VALID_STATUSES; do
        [[ "$status" == "$valid" ]] && return 0
    done
    echo "Error: invalid status '$status'. Must be one of: $VALID_STATUSES" >&2
    return 1
}

cmd_status() {
    if [[ $# -lt 2 ]]; then
        echo "Usage: $(basename "$0") status <id> <status>" >&2
        echo "Valid statuses: $VALID_STATUSES" >&2
        return 1
    fi

    local id="$1"
    local status="$2"

    validate_status "$status" || return 1

    local file
    file=$(ticket_path "$id") || return 1

    update_yaml_field "$file" "status" "$status"
    echo "Updated $(basename "$file" .md) -> $status"
}

cmd_start() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: $(basename "$0") start <id>" >&2
        return 1
    fi
    cmd_status "$1" "in_progress"
}

cmd_close() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: $(basename "$0") close <id>" >&2
        return 1
    fi
    cmd_status "$1" "closed"
}

cmd_reopen() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: $(basename "$0") reopen <id>" >&2
        return 1
    fi
    cmd_status "$1" "open"
}

cmd_dep_tree() {
    local full_mode=0
    local root_id=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full) full_mode=1; shift ;;
            *)
                if [[ -n "$root_id" ]]; then
                    echo "Usage: $(basename "$0") dep tree [--full] [id]" >&2
                    return 1
                fi
                root_id="$1"
                shift
                ;;
        esac
    done

    if [[ -n "$root_id" ]]; then
        local root_file
        root_file=$(ticket_path "$root_id") || return 1
        root_id=$(basename "$root_file" .md)
    fi

    load_ticket_files
    [[ ${#TICKET_FILES[@]} -eq 0 ]] && return 0

    awk -v root_id="$root_id" -v full_mode="$full_mode" '
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; deps=""; in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && /^---$/ { in_front = 1; next }
    in_front && /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^deps:/ {
        deps = $2
        gsub(/[\[\] ]/, "", deps)
    }
    !in_front && /^# / && title == "" { title = substr($0, 3) }

    function store(    i, n) {
        if (id != "") {
            statuses[id] = status
            titles[id] = title
            deps_raw[id] = deps
            n = split(deps, arr, ",")
            for (i = 1; i <= n; i++) if (arr[i] != "") {
                dep_count[id]++
                dep_list[id, dep_count[id]] = arr[i]
                reverse_count[arr[i]]++
            }
        }
    }

    function sort_values(arr, n,    i, j, tmp) {
        for (i = 2; i <= n; i++) {
            tmp = arr[i]
            j = i - 1
            while (j >= 1 && arr[j] > tmp) {
                arr[j + 1] = arr[j]
                j--
            }
            arr[j + 1] = tmp
        }
    }

    function print_node(id, prefix, connector, is_last, path,    i, n, child, arr, child_prefix) {
        if (!(id in statuses)) return

        if (index(path, ":" id ":") > 0) {
            printf "%s%s%-8s [%s] - %s (cycle)\n", prefix, connector, id, statuses[id], titles[id]
            return
        }

        if (!full_mode && (id in printed)) {
            printf "%s%s%-8s [%s] - %s (shared)\n", prefix, connector, id, statuses[id], titles[id]
            return
        }

        printf "%s%s%-8s [%s] - %s\n", prefix, connector, id, statuses[id], titles[id]
        rendered[id] = 1
        if (!full_mode) printed[id] = 1

        n = 0
        for (i = 1; i <= dep_count[id]; i++) {
            child = dep_list[id, i]
            if (child in statuses) arr[++n] = child
        }
        if (n == 0) return

        sort_values(arr, n)
        child_prefix = prefix
        if (connector != "") child_prefix = prefix (is_last ? "    " : "│   ")
        path = path id ":"

        for (i = 1; i <= n; i++) {
            print_node(arr[i], child_prefix, (i == n ? "└── " : "├── "), i == n, path)
        }
    }

    END {
        if (prev_file) store()

        if (root_id != "") {
            print_node(root_id, "", "", 1, ":")
            exit
        }

        root_count = 0
        for (id in statuses) {
            if (!(id in reverse_count)) roots[++root_count] = id
        }
        sort_values(roots, root_count)

        for (i = 1; i <= root_count; i++) {
            print_node(roots[i], "", "", 1, ":")
        }

        extra_count = 0
        for (id in statuses) {
            if (!(id in rendered)) extras[++extra_count] = id
        }
        sort_values(extras, extra_count)
        for (i = 1; i <= extra_count; i++) {
            if (!(extras[i] in rendered)) print_node(extras[i], "", "", 1, ":")
        }
    }
    ' "${TICKET_FILES[@]}" 2>/dev/null
}

cmd_dep() {
    # Handle subcommands
    if [[ "${1:-}" == "tree" ]]; then
        shift
        cmd_dep_tree "$@"
        return
    fi

    if [[ $# -lt 2 ]]; then
        echo "Usage: ticket dep <id> <dependency-id>" >&2
        echo "       ticket dep tree [id]  - show dependency tree" >&2
        return 1
    fi

    local id="$1"
    local dep_id="$2"
    local file
    file=$(ticket_path "$id") || return 1

    # Verify dependency exists and resolve to full ID
    local dep_file
    dep_file=$(ticket_path "$dep_id") || return 1
    dep_id=$(basename "$dep_file" .md)

    if [[ "$(basename "$file" .md)" == "$dep_id" ]]; then
        echo "Error: a ticket cannot depend on itself" >&2
        return 1
    fi

    # Get current deps
    local current_deps
    current_deps=$(yaml_field "$file" "deps")

    # Add dep if not already present
    if array_contains "$current_deps" "$dep_id"; then
        echo "Dependency already exists"
        return 0
    fi

    update_yaml_field "$file" "deps" "$(array_append "$current_deps" "$dep_id")"

    echo "Added dependency: $(basename "$file" .md) -> $dep_id"
}

cmd_ls() {
    local status_filter=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --status=*) status_filter="${1#--status=}"; shift ;;
            *) shift ;;
        esac
    done

    load_ticket_files
    [[ ${#TICKET_FILES[@]} -eq 0 ]] && return 0

    awk -v status_filter="$status_filter" '
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) emit()
        id=""; status=""; title=""; deps=""; in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && /^---$/ { in_front = 1; next }
    in_front && /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^deps:/ {
        deps = $2
        gsub(/[\[\] ]/, "", deps)
    }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    END { if (prev_file) emit() }
    function emit() {
        if (id != "" && (status_filter == "" || status == status_filter)) {
            deps_display = (deps != "") ? "[" deps "]" : "[]"
            gsub(/,/, ", ", deps_display)
            dep_str = (deps_display != "[]") ? " <- " deps_display : ""
            printf "%-8s [%s] - %s%s\n", id, status, title, dep_str
        }
    }
    ' "${TICKET_FILES[@]}" 2>/dev/null
}

cmd_tree() {
    local root_id=""

    if [[ $# -gt 1 ]]; then
        echo "Usage: $(basename "$0") tree [id]" >&2
        return 1
    fi

    if [[ $# -eq 1 ]]; then
        local root_file
        root_file=$(ticket_path "$1") || return 1
        root_id=$(basename "$root_file" .md)
    fi

    load_ticket_files
    [[ ${#TICKET_FILES[@]} -eq 0 ]] && return 0

    awk -v target="$root_id" '
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; parent=""; in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && /^---$/ { in_front = 1; next }
    in_front && /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^parent:/ { parent = $2 }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function store() {
        if (id != "") {
            statuses[id] = status
            titles[id] = title
            parents[id] = parent
            child_count[parent]++
            children[parent, child_count[parent]] = id
        }
    }
    function sort_values(arr, n,    i, j, tmp) {
        for (i = 2; i <= n; i++) {
            tmp = arr[i]
            j = i - 1
            while (j >= 1 && arr[j] > tmp) {
                arr[j + 1] = arr[j]
                j--
            }
            arr[j + 1] = tmp
        }
    }
    function print_node(id, prefix, connector, is_last, path,    i, n, child, arr, child_prefix) {
        if (!(id in statuses)) return
        if (index(path, ":" id ":") > 0) {
            printf "%s%s%-8s [%s] - %s (cycle)\n", prefix, connector, id, statuses[id], titles[id]
            return
        }

        printf "%s%s%-8s [%s] - %s\n", prefix, connector, id, statuses[id], titles[id]
        printed[id] = 1

        n = 0
        for (i = 1; i <= child_count[id]; i++) {
            child = children[id, i]
            if (child != "") arr[++n] = child
        }
        if (n == 0) return

        sort_values(arr, n)
        child_prefix = prefix
        if (connector != "") child_prefix = prefix (is_last ? "    " : "│   ")
        path = path id ":"

        for (i = 1; i <= n; i++) {
            print_node(arr[i], child_prefix, (i == n ? "└── " : "├── "), i == n, path)
        }
    }
    END {
        if (prev_file) store()

        if (target != "") {
            root = target
            while ((root in parents) && parents[root] != "" && (parents[root] in statuses) && !(parents[root] in seen_up)) {
                seen_up[root] = 1
                root = parents[root]
            }
            print_node(root, "", "", 1, ":")
            exit
        }

        root_count = 0
        for (id in statuses) {
            if (parents[id] == "" || !(parents[id] in statuses)) {
                roots[++root_count] = id
            }
        }
        sort_values(roots, root_count)

        for (i = 1; i <= root_count; i++) {
            if (!(roots[i] in printed)) print_node(roots[i], "", "", 1, ":")
        }

        extra_count = 0
        for (id in statuses) {
            if (!(id in printed)) extras[++extra_count] = id
        }
        sort_values(extras, extra_count)
        for (i = 1; i <= extra_count; i++) {
            if (!(extras[i] in printed)) print_node(extras[i], "", "", 1, ":")
        }
    }
    ' "${TICKET_FILES[@]}" 2>/dev/null
}

cmd_ready() {
    load_ticket_files
    [[ ${#TICKET_FILES[@]} -eq 0 ]] && return 0

    awk '
    BEGIN { FS=": "; in_front=0; sep=sprintf("%c", 31) }
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; deps=""; priority=""; in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && /^---$/ { in_front = 1; next }
    in_front && /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^priority:/ { priority = $2 }
    in_front && /^deps:/ {
        deps = $2
        gsub(/[\[\] ]/, "", deps)
    }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function store() {
        if (id != "") {
            statuses[id] = status
            titles[id] = title
            deps_raw[id] = deps
            priorities[id] = (priority != "") ? priority : 2
        }
    }
    END {
        if (prev_file) store()
        for (id in statuses) {
            status = statuses[id]
            if (status != "open" && status != "in_progress") continue

            deps = deps_raw[id]
            ready = 1
            if (deps != "") {
                n = split(deps, arr, ",")
                for (i = 1; i <= n; i++) {
                    dep = arr[i]
                    if (dep != "" && statuses[dep] != "closed") {
                        ready = 0
                        break
                    }
                }
            }
            if (ready) {
                output[++count] = priorities[id] sep id sep status sep titles[id]
            }
        }

        for (i = 1; i <= count; i++) {
            for (j = i + 1; j <= count; j++) {
                split(output[i], a, sep)
                split(output[j], b, sep)
                if (a[1] > b[1] || (a[1] == b[1] && a[2] > b[2])) {
                    tmp = output[i]; output[i] = output[j]; output[j] = tmp
                }
            }
        }

        for (i = 1; i <= count; i++) {
            split(output[i], f, sep)
            printf "%-8s [P%s][%s] - %s\n", f[2], f[1], f[3], f[4]
        }
    }
    ' "${TICKET_FILES[@]}" 2>/dev/null
}

cmd_closed() {
    local limit=20
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --limit=*) limit="${1#--limit=}"; shift ;;
            *) shift ;;
        esac
    done

    load_ticket_files
    [[ ${#TICKET_FILES[@]} -eq 0 ]] && return 0

    local -a files=()
    mapfile -t files < <(ls -t -- "${TICKET_FILES[@]}" | head -n 100)
    [[ ${#files[@]} -eq 0 ]] && return 0
    awk '
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) emit()
        id=""; status=""; title=""; in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && /^---$/ { in_front = 1; next }
    in_front && /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function emit() {
        if (id != "" && status == "closed") {
            output[++count] = sprintf("%-8s [%s] - %s", id, status, title)
        }
    }
    END {
        if (prev_file) emit()
        for (i = 1; i <= count; i++) print output[i]
    }
    ' "${files[@]}" | head -n "$limit"
}

ticket_outgoing_refs() {
    local file="$1"
    local parent deps dep_id

    parent=$(yaml_field "$file" "parent")
    [[ -n "$parent" ]] && printf '%s\n' "$parent"

    deps=$(yaml_field "$file" "deps")
    deps="${deps#[}"
    deps="${deps%]}"
    deps="${deps// /}"
    [[ -z "$deps" ]] && return 0

    local -a dep_ids
    IFS=',' read -r -a dep_ids <<< "$deps"
    for dep_id in "${dep_ids[@]}"; do
        [[ -n "$dep_id" ]] && printf '%s\n' "$dep_id"
    done
}

cmd_prune() {
    if [[ $# -gt 0 ]]; then
        echo "Usage: $(basename "$0") prune" >&2
        return 1
    fi

    load_ticket_files
    [[ ${#TICKET_FILES[@]} -eq 0 ]] && {
        echo "No closed tickets to prune"
        return 0
    }

    local -A file_by_id=() reachable=()
    local -a closed_ids=() queue=()
    local file id status current ref_id
    local head=0 count=0 retained=0

    for file in "${TICKET_FILES[@]}"; do
        id=$(basename "$file" .md)
        status=$(yaml_field "$file" "status")
        file_by_id["$id"]="$file"
        if [[ "$status" == "closed" ]]; then
            closed_ids+=("$id")
        else
            queue+=("$id")
        fi
    done

    [[ ${#closed_ids[@]} -eq 0 ]] && {
        echo "No closed tickets to prune"
        return 0
    }

    while [[ $head -lt ${#queue[@]} ]]; do
        current="${queue[$head]}"
        ((head += 1))

        [[ -n "${reachable[$current]:-}" ]] && continue
        reachable["$current"]=1

        file="${file_by_id[$current]:-}"
        [[ -z "$file" ]] && continue

        while IFS= read -r ref_id; do
            [[ -z "$ref_id" || -z "${file_by_id[$ref_id]:-}" || -n "${reachable[$ref_id]:-}" ]] && continue
            queue+=("$ref_id")
        done < <(ticket_outgoing_refs "$file")
    done

    for id in "${closed_ids[@]}"; do
        if [[ -n "${reachable[$id]:-}" ]]; then
            echo "Retained $id (still reachable from non-closed tickets)"
            ((retained += 1))
            continue
        fi

        rm -f "${file_by_id[$id]}"
        echo "Pruned $id"
        ((count += 1))
    done

    [[ $count -gt 0 ]] && echo "Pruned $count ticket(s)"
    [[ $retained -gt 0 ]] && echo "Retained $retained closed ticket(s) still reachable from non-closed tickets"
}

cmd_delete() {
    if [[ $# -ne 1 ]]; then
        echo "Usage: $(basename "$0") delete <id>" >&2
        return 1
    fi

    local file id refs
    file=$(ticket_path "$1") || return 1
    id=$(basename "$file" .md)
    refs=$(ticket_references "$id")

    if [[ -n "$refs" ]]; then
        echo "Error: cannot delete $id ($(format_references "$refs"))" >&2
        return 1
    fi

    rm -f "$file"
    echo "Deleted $id"
}

cmd_blocked() {
    load_ticket_files
    [[ ${#TICKET_FILES[@]} -eq 0 ]] && return 0

    awk '
    BEGIN { FS=": "; in_front=0; sep=sprintf("%c", 31) }
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; deps=""; priority=""; in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && /^---$/ { in_front = 1; next }
    in_front && /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^priority:/ { priority = $2 }
    in_front && /^deps:/ {
        deps = $2
        gsub(/[\[\] ]/, "", deps)
    }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function store() {
        if (id != "") {
            statuses[id] = status
            titles[id] = title
            deps_raw[id] = deps
            priorities[id] = (priority != "") ? priority : 2
        }
    }
    END {
        if (prev_file) store()
        for (id in statuses) {
            status = statuses[id]
            if (status != "open" && status != "in_progress") continue

            deps = deps_raw[id]
            if (deps == "") continue

            blocked = 0
            n = split(deps, arr, ",")
            for (i = 1; i <= n; i++) {
                dep = arr[i]
                if (dep != "" && statuses[dep] != "closed") {
                    blocked = 1
                    break
                }
            }
            if (blocked) {
                blockers = ""
                n = split(deps, arr, ",")
                for (i = 1; i <= n; i++) {
                    dep = arr[i]
                    if (dep != "" && statuses[dep] != "closed") {
                        blockers = (blockers == "") ? dep : blockers ", " dep
                    }
                }
                output[++count] = priorities[id] sep id sep status sep titles[id] sep "[" blockers "]"
            }
        }

        for (i = 1; i <= count; i++) {
            for (j = i + 1; j <= count; j++) {
                split(output[i], a, sep)
                split(output[j], b, sep)
                if (a[1] > b[1] || (a[1] == b[1] && a[2] > b[2])) {
                    tmp = output[i]; output[i] = output[j]; output[j] = tmp
                }
            }
        }

        for (i = 1; i <= count; i++) {
            split(output[i], f, sep)
            printf "%-8s [P%s][%s] - %s <- %s\n", f[2], f[1], f[3], f[4], f[5]
        }
    }
    ' "${TICKET_FILES[@]}" 2>/dev/null
}

cmd_undep() {
    if [[ $# -lt 2 ]]; then
        echo "Usage: ticket undep <id> <dependency-id>" >&2
        return 1
    fi

    local id="$1"
    local dep_id="$2"
    local file
    file=$(ticket_path "$id") || return 1

    # Resolve dep_id to full ID
    local dep_file
    dep_file=$(ticket_path "$dep_id") || return 1
    dep_id=$(basename "$dep_file" .md)

    local current_deps
    current_deps=$(yaml_field "$file" "deps")

    if ! array_contains "$current_deps" "$dep_id"; then
        echo "Dependency not found"
        return 1
    fi

    update_yaml_field "$file" "deps" "$(array_remove "$current_deps" "$dep_id")"
    echo "Removed dependency: $(basename "$file" .md) -/-> $dep_id"
}

cmd_show() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: ticket show <id>" >&2
        return 1
    fi

    local file
    file=$(ticket_path "$1") || return 1
    local target_id
    target_id=$(basename "$file" .md)

    load_ticket_files

    _show_output() {
        awk -v target="$target_id" -v target_file="$file" '
    BEGIN { FS=": "; in_front=0 }

    # First pass: collect all ticket metadata
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; deps=""; parent=""; in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && /^---$/ { in_front = 1; next }
    in_front && /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^deps:/ { deps = $2; gsub(/[\[\] ]/, "", deps) }
    in_front && /^parent:/ { parent = $2 }
    !in_front && /^# / && title == "" { title = substr($0, 3) }

    function store() {
        if (id != "") {
            statuses[id] = status
            titles[id] = title
            all_deps[id] = deps
            parents[id] = parent
        }
    }

    END {
        if (prev_file) store()

        # Build inverse relationships
        for (id in statuses) {
            # Children: tickets where parent == target
            if (parents[id] == target) {
                children_count++
                children[children_count] = id
            }
            # Blocking: tickets where target is in their deps
            deps = all_deps[id]
            if (deps != "") {
                n = split(deps, arr, ",")
                for (i = 1; i <= n; i++) {
                    if (arr[i] == target && statuses[id] != "closed") {
                        blocking_count++
                        blocking[blocking_count] = id
                    }
                }
            }
        }

        # Now output the target file with enhancements
        in_front = 0
        target_line = 0
        while ((getline line < target_file) > 0) {
            target_line++
            if (target_line == 1 && line == "---") {
                in_front = 1
                print line
            } else if (in_front && line == "---") {
                in_front = 0
                print line
            } else if (in_front && line ~ /^parent:/) {
                # Add parent title as comment
                p = line
                sub(/^parent: */, "", p)
                if (p in titles) {
                    print line "  # " titles[p]
                } else {
                    print line
                }
            } else {
                print line
            }
        }
        close(target_file)

        # Collect blockers (unclosed deps)
        deps = all_deps[target]
        if (deps != "") {
            n = split(deps, arr, ",")
            blocker_count = 0
            for (i = 1; i <= n; i++) {
                d = arr[i]
                if (d != "" && statuses[d] != "closed") {
                    blocker_count++
                    blockers[blocker_count] = d
                }
            }
            if (blocker_count > 0) {
                print ""
                print "## Blockers"
                print ""
                for (i = 1; i <= blocker_count; i++) {
                    d = blockers[i]
                    printf "- %s [%s] %s\n", d, statuses[d], titles[d]
                }
            }
        }

        # Show tickets this is blocking
        if (blocking_count > 0) {
            print ""
            print "## Blocking"
            print ""
            for (i = 1; i <= blocking_count; i++) {
                b = blocking[i]
                printf "- %s [%s] %s\n", b, statuses[b], titles[b]
            }
        }

        # Show children
        if (children_count > 0) {
            print ""
            print "## Children"
            print ""
            for (i = 1; i <= children_count; i++) {
                c = children[i]
                printf "- %s [%s] %s\n", c, statuses[c], titles[c]
            }
        }
    }
    ' "${TICKET_FILES[@]}" 2>/dev/null
    }

    if [[ -t 1 && -n "$TICKET_PAGER" ]]; then
        read -r -a pager_cmd <<<"$TICKET_PAGER"
        _show_output | "${pager_cmd[@]}"
    else
        _show_output
    fi
}

cmd_add_note() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: ticket add-note <id> [note text]" >&2
        return 1
    fi

    local file
    file=$(ticket_path "$1") || return 1
    shift

    local note
    if [[ $# -gt 0 ]]; then
        note="$*"
    elif [[ ! -t 0 ]]; then
        note=$(cat)
    else
        echo "Error: no note provided" >&2
        return 1
    fi

    local timestamp
    timestamp=$(_iso_date)

    # Add Notes section if missing, then append timestamped note
    if ! grep -q '^## Notes' "$file"; then
        printf '\n## Notes\n' >> "$file"
    fi
    printf '\n**%s**\n\n%s\n' "$timestamp" "$note" >> "$file"

    echo "Note added to $(basename "$file" .md)"
}

cmd_help() {
    local cmd
    cmd=$(basename "$0")
    cat << EOF
$cmd - minimal ticket system with dependency tracking

Usage: $cmd <command> [args]

Commands:
  create [title] [options] Create ticket, prints ID
    -d, --description      Description text
    -p, --priority         Priority 0-4, 0=highest [default: 2]
    --parent               Parent ticket ID
  start <id>               Set status to in_progress
  close <id>               Set status to closed
  reopen <id>              Set status to open
  status <id> <status>     Update status (open|in_progress|closed)
  dep <id> <dep-id>        Add dependency (id depends on dep-id)
  dep tree [--full] [id]   Show dependency tree, optionally for one ticket
  undep <id> <dep-id>      Remove dependency
  ls|list [--status=X]     List tickets
  tree [id]                Show tickets in parent/child hierarchy
  ready                    List open/in-progress tickets with deps resolved
  blocked                  List open/in-progress tickets with unresolved deps
  closed [--limit=N]       List recently closed tickets (default 20, by mtime)
  prune                    Delete closed tickets not reachable from non-closed tickets
  delete <id>              Delete one unreferenced ticket
  show <id>                Display ticket
  add-note <id> [text]     Append timestamped note (or pipe via stdin)

Create work with '$cmd create "Title"' and optionally group it under a larger task with '--parent <id>' to model a subtask. Use '$cmd dep <id> <dep-id>' when one ticket is blocked by another ticket and cannot be completed first. In other words, A -> B means ticket A depends on B. Use parent/child links to describe breakdown of work, and dependency links to describe execution order or blocking relationships.

Examples:
  $cmd create "Ship release notes"
  $cmd create "Draft changelog" --parent abc123
  $cmd create "Publish GitHub release" --parent abc123
  $cmd dep publish-id changelog-id   # publish is blocked by changelog
EOF
}

# Main dispatch

# Initialize tickets dir for built-in commands (skip for help)
case "${1:-help}" in
    help|--help|-h) ;;
    *) init_tickets_dir "${1:-}" || exit 1 ;;
esac

# Built-in commands
case "${1:-help}" in
    create) shift; cmd_create "$@" ;;
    start)  shift; cmd_start "$@" ;;
    close)  shift; cmd_close "$@" ;;
    reopen) shift; cmd_reopen "$@" ;;
    status) shift; cmd_status "$@" ;;
    dep)    shift; cmd_dep "$@" ;;
    undep)  shift; cmd_undep "$@" ;;
    ls|list) shift; cmd_ls "$@" ;;
    tree)   shift; cmd_tree "$@" ;;
    ready)  shift; cmd_ready "$@" ;;
    blocked) shift; cmd_blocked "$@" ;;
    closed) shift; cmd_closed "$@" ;;
    prune)  shift; cmd_prune "$@" ;;
    delete) shift; cmd_delete "$@" ;;
    show)   shift; cmd_show "$@" ;;
    add-note) shift; cmd_add_note "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
        echo "Unknown command: $1" >&2
        cmd_help >&2
        exit 1
        ;;
esac
