cmd_undep() {
    if [[ $# -ne 2 ]]; then
        print_usage undep >&2
        return 1
    fi
    if [[ "$1" == -* || "$2" == -* ]]; then
        local invalid_arg="$1"
        [[ "$2" == -* ]] && invalid_arg="$2"
        print_argument_error undep "Unknown option: $invalid_arg"
        return 1
    fi

    local id="$1"
    local dep_id="$2"
    acquire_store_lock || return 1

    local file
    file=$(ticket_path "$id") || return 1

    local current_deps dep_file candidate
    current_deps=$(yaml_field "$file" "deps")
    read -r dep_id <<< "$dep_id"
    validate_id_fragment "$dep_id" || return 1

    local raw_deps match_count=0 matched_id=""
    raw_deps="${current_deps#[}"
    raw_deps="${raw_deps%]}"
    raw_deps="${raw_deps// /}"
    local -a dep_ids=()
    [[ -n "$raw_deps" ]] && IFS=',' read -r -a dep_ids <<< "$raw_deps"

    if array_contains "$current_deps" "$dep_id"; then
        matched_id="$dep_id"
        match_count=1
    else
        for candidate in "${dep_ids[@]}"; do
            if [[ "$candidate" == *"$dep_id"* ]]; then
                matched_id="$candidate"
                ((match_count += 1))
