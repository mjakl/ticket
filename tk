                    return 1
                fi
                validate_status "$status_value" || return 1
                status_filter="${status_filter:+$status_filter }$status_value"
                shift
                ;;
            --status)
                if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                    echo "Error: --status requires a value" >&2
                    print_usage list >&2
                    return 1
                fi
                status_value="$2"
                validate_status "$status_value" || return 1
                status_filter="${status_filter:+$status_filter }$status_value"
