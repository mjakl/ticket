    if [[ $match_count -gt 1 ]]; then
        printf "Error: ambiguous ID '%s' matches multiple stored dependencies\n" "$dep_id" >&2
        return 1
    elif [[ $match_count -eq 1 ]]; then
        dep_id="$matched_id"
    elif dep_file=$(ticket_path "$dep_id" 2>/dev/null); then
        dep_id=$(basename "$dep_file" .md)
    else
        echo "Dependency not found"
        return 0
    fi

    if ! array_contains "$current_deps" "$dep_id"; then
        echo "Dependency not found"
        return 0
    fi

    update_yaml_field "$file" "deps" "$(array_remove "$current_deps" "$dep_id")"
    echo "Removed dependency: $(basename "$file" .md) -/-> $dep_id"
}

cmd_show() {
    if [[ $# -ne 1 ]]; then
        print_usage show >&2
        return 1
    fi
    if [[ "$1" == -* ]]; then
        print_argument_error show "Unknown option: $1"
        return 1
    fi

    local file
    file=$(ticket_path "$1") || return 1
    local target_id
    target_id=$(basename "$file" .md)

    load_ticket_files

    _show_output() {
        awk -v target="$target_id" -v target_file="$file" '
    BEGIN { FS=": "; in_front=0 }

    # First pass: collect all ticket metadata
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; deps=""; parent=""; in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && /^---$/ { in_front = 1; next }
    in_front && /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^deps:/ { deps = $2; gsub(/[\[\] ]/, "", deps) }
    in_front && /^parent:/ { parent = $2 }
    !in_front && /^# / && title == "" { title = substr($0, 3) }

    function store() {
        if (id != "") {
            statuses[id] = status
            titles[id] = title
            all_deps[id] = deps
            parents[id] = parent
        }
    }

    END {
        if (prev_file) store()

        # Build inverse relationships
        for (id in statuses) {
            # Children: tickets where parent == target
            if (parents[id] == target) {
                children_count++
                children[children_count] = id
            }
            # Blocking: tickets where target is in their deps
            deps = all_deps[id]
            if (deps != "") {
                n = split(deps, arr, ",")
                for (i = 1; i <= n; i++) {
                    if (arr[i] == target && statuses[id] != "closed") {
                        blocking_count++
                        blocking[blocking_count] = id
                    }
                }
            }
        }

        # Now output the target file with enhancements
        in_front = 0
        target_line = 0
        while ((getline line < target_file) > 0) {
            target_line++
            if (target_line == 1 && line == "---") {
                in_front = 1
                print line
            } else if (in_front && line == "---") {
                in_front = 0
                print line
            } else if (in_front && line ~ /^parent:/) {
                # Add parent title as comment
                p = line
                sub(/^parent: */, "", p)
                if (p in titles) {
                    print line "  # " titles[p]
                } else {
                    print line
                }
            } else {
                print line
            }
        }
        close(target_file)

        # Collect blockers (unclosed deps)
        deps = all_deps[target]
        if (deps != "") {
            n = split(deps, arr, ",")
            blocker_count = 0
            for (i = 1; i <= n; i++) {
                d = arr[i]
                if (d != "" && statuses[d] != "closed") {
                    blocker_count++
                    blockers[blocker_count] = d
                }
            }
            if (blocker_count > 0) {
                print ""
                print "## Blockers"
                print ""
                for (i = 1; i <= blocker_count; i++) {
                    d = blockers[i]
                    printf "- %s [%s] %s\n", d, statuses[d], titles[d]
                }
            }
        }

        # Show tickets this is blocking
        if (blocking_count > 0) {
            print ""
            print "## Blocking"
            print ""
            for (i = 1; i <= blocking_count; i++) {
                b = blocking[i]
                printf "- %s [%s] %s\n", b, statuses[b], titles[b]
            }
        }

        # Show children
        if (children_count > 0) {
            print ""
            print "## Children"
            print ""
            for (i = 1; i <= children_count; i++) {
                c = children[i]
                printf "- %s [%s] %s\n", c, statuses[c], titles[c]
            }
        }
    }
    ' "${TICKET_FILES[@]}"
    }

    if [[ -t 1 && -n "$TICKET_PAGER" ]]; then
        read -r -a pager_cmd <<<"$TICKET_PAGER"
        _show_output | "${pager_cmd[@]}"
    else
        _show_output
    fi
}

cmd_add_note() {
    if [[ $# -lt 1 ]]; then
        print_usage add-note >&2
        return 1
    fi
    if [[ "$1" == -* ]]; then
        print_argument_error add-note "Unknown option: $1"
        return 1
    fi

    local id="$1"
    shift

    if [[ "${1:-}" == "--" ]]; then
        shift
    else
        local arg
        for arg in "$@"; do
            if [[ "$arg" == -* ]]; then
                print_argument_error add-note "Unknown option: $arg"
                return 1
            fi
        done
    fi

    local note
    if [[ $# -gt 0 ]]; then
        note="$*"
    elif [[ ! -t 0 ]]; then
        note=$(cat)
    else
        echo "Error: no note provided" >&2
        return 1
    fi

    if [[ -z "$note" ]]; then
        echo "Error: no note provided" >&2
        return 1
    fi

    acquire_store_lock || return 1

    local file tmp timestamp
    file=$(ticket_path "$id") || return 1
    timestamp=$(_iso_date)
    prepare_rewrite_temp "$file" || return 1
    tmp="$STORE_LAST_TEMP"

    if ! grep -q '^## Notes' "$tmp"; then
        printf '\n## Notes\n' >> "$tmp"
    fi
    printf '\n**%s**\n\n%s\n' "$timestamp" "$note" >> "$tmp"
    preserve_ticket_mode "$file" "$tmp"
    mv "$tmp" "$file"

    echo "Note added to $(basename "$file" .md)"
}

cmd_help() {
    local cmd topic subtopic
    cmd=$(basename "$0")
    topic="${1:-}"
    subtopic="${2:-}"

    if [[ -z "$subtopic" && "$topic" == "dep-tree" ]]; then
        echo "Unknown help topic: $topic" >&2
        print_usage help >&2
        return 1
    fi

    if [[ $# -gt 2 ]]; then
        print_argument_error help "Unexpected argument: ${3}"
        return 1
    fi

    if [[ -n "$subtopic" ]]; then
        if [[ "$topic" == "dep" && "$subtopic" == "tree" ]]; then
            topic="dep-tree"
        else
            echo "Unknown help topic: $topic $subtopic" >&2
            print_usage help >&2
            return 1
        fi
    fi

    [[ "$topic" == "ls" ]] && topic="list"

    case "$topic" in
        "")
            cat << EOF
$cmd - minimal ticket system with dependency tracking

Usage: $cmd <command> [args]

Commands:
  init [--tracked]         Initialize .tickets/ and ignore it by default
  create [title] [options] Create ticket, prints ID
    -d, --description      Description text, or '-' to read from stdin
    -p, --priority         Priority 0-4, 0=highest [default: 2]
    --parent               Parent ticket ID
  start <id>               Set status to in_progress
  close <id>               Set status to closed
  reopen <id>              Set status to open
  status <id> <status>     Update status (open|in_progress|closed)
  dep <id> <dep-id>        Add dependency (id depends on dep-id)
  dep tree [--full] [id]   Show dependency tree, optionally for one ticket
  undep <id> <dep-id>      Remove dependency
  ls|list [--status X]     List tickets
  tree [id]                Show tickets in parent/child hierarchy
  ready                    List open/in-progress tickets with deps resolved
  blocked                  List open/in-progress tickets with unresolved deps
  done                     Exit 0 when all tickets are closed, 1 otherwise
  closed [--limit N]       List recently closed tickets (default 20, by mtime)
  prune                    Delete closed tickets not reachable from non-closed tickets
  delete <id>              Delete one unreferenced ticket
  show <id>                Display ticket
  add-note <id> [text]     Append timestamped note (or pipe via stdin)

Create work with '$cmd create "Title"' and optionally group it under a larger task with '--parent <id>' to model a subtask. Use '$cmd dep <id> <dep-id>' when one ticket is blocked by another ticket and cannot be completed first. In other words, A -> B means ticket A depends on B. Use parent/child links to describe breakdown of work, and dependency links to describe execution order or blocking relationships.

Examples:
  $cmd create "Ship release notes"
  $cmd create "Draft changelog" --parent abc123
  $cmd create "Publish GitHub release" --parent abc123
  $cmd dep publish-id changelog-id   # publish is blocked by changelog
EOF
            ;;
        init)
            print_usage init
            cat << EOF

Initialize the ticket store. By default, add .tickets/ to .gitignore.

Options:
  --tracked  Leave .tickets/ trackable by git

Example:
  $cmd init --tracked
EOF
            ;;
        create)
            print_usage create
            cat << EOF

Create an open ticket and print only its ID. The title defaults to "Untitled".

Options:
  -d, --description <text>  Description text, or '-' to read from stdin
                             Use --description=<text> when text starts with '-'
  -p, --priority <0-4>      Priority, 0=highest [default: 2]
  --parent <id>             Parent ticket ID
  --                        End options (for titles starting with '-')

Examples:
  $cmd create "Ship release notes"
  $cmd create "Draft changelog" --parent abc123 -p 1
  $cmd create -- "- follow-up"
EOF
            ;;
        start|close|reopen)
            print_usage "$topic"
            local target_status
            case "$topic" in
                start) target_status="in_progress" ;;
                close) target_status="closed" ;;
                reopen) target_status="open" ;;
            esac
            cat << EOF

Set a ticket's status to $target_status. Partial IDs are accepted when unambiguous.
Repeating the same status change is a successful no-op.

Example:
  $cmd $topic abc123
EOF
            ;;
        status)
            print_usage status
            cat << EOF

Set a ticket's status explicitly. Valid statuses: open, in_progress, closed.
Partial IDs are accepted when unambiguous; unchanged status is a successful no-op.

Example:
  $cmd status abc123 in_progress
EOF
            ;;
        dep)
            print_usage dep
            cat << EOF

Add a blocking dependency: <id> depends on <dependency-id>.
Use '$cmd dep tree --help' for dependency-tree options.

Example:
  $cmd dep task-id blocker-id
EOF
            ;;
        dep-tree)
            print_usage dep-tree
            cat << EOF

Show the global dependency graph, or focus it on one ticket.
Shared nodes are abbreviated unless --full is used.

Options:
  --full  Repeat shared subgraphs in full

Examples:
  $cmd dep tree
  $cmd dep tree --full abc123
EOF
            ;;
        undep)
            print_usage undep
            cat << EOF

Remove a blocking dependency. A missing relationship is a successful no-op.

Example:
  $cmd undep task-id blocker-id
EOF
            ;;
        list)
            print_usage list
            cat << EOF

List tickets. Repeat --status to include multiple statuses.

Options:
  --status <status>  Filter by open, in_progress, or closed

Examples:
  $cmd list
  $cmd list --status open --status in_progress
EOF
            ;;
        tree)
            print_usage tree
            cat << EOF

Show tickets in their parent/child hierarchy, optionally focused on one ticket.

Examples:
  $cmd tree
  $cmd tree abc123
EOF
            ;;
        ready)
            print_usage ready
            cat << EOF

List open or in-progress tickets whose dependencies are resolved.

Example:
  $cmd ready
EOF
            ;;
        blocked)
            print_usage blocked
            cat << EOF

List open or in-progress tickets with unresolved dependencies.

Example:
  $cmd blocked
EOF
            ;;
        done)
            print_usage "done"
            cat << EOF

Exit 0 when every ticket is closed; otherwise list unfinished tickets and exit 1.

Example:
  $cmd done
EOF
            ;;
        closed)
            print_usage closed
            cat << EOF

List recently closed tickets by file modification time.

Options:
  --limit <number>  Maximum tickets to show [default: 20]

Example:
  $cmd closed --limit 5
EOF
            ;;
        prune)
            print_usage prune
            cat << EOF

Delete closed tickets that are not reachable from any non-closed ticket.

Example:
  $cmd prune
EOF
            ;;
        delete)
            print_usage delete
            cat << EOF

Delete one ticket. Referenced tickets cannot be deleted.
Partial IDs are accepted when unambiguous.

Example:
  $cmd delete abc123
EOF
            ;;
        show)
            print_usage show
            cat << EOF

Display a ticket with computed blockers, blocking tickets, and children.
Partial IDs are accepted when unambiguous.

Example:
  $cmd show abc123
EOF
            ;;
        add-note)
            print_usage add-note
            cat << EOF

Append a UTC-timestamped note. When text is omitted, read it from stdin.
Use '--' before note text that starts with '-'.

Examples:
  $cmd add-note abc123 "Validated the fix"
  $cmd add-note abc123 -- "- follow-up needed"
  printf '%s\n' "Multiline note" | $cmd add-note abc123
EOF
            ;;
        help|--help|-h)
            print_usage help
            cat << EOF

Show global help or focused help for one command.

Examples:
  $cmd help
  $cmd help create
  $cmd help dep tree
EOF
            ;;
        *)
            echo "Unknown help topic: $topic" >&2
            print_usage help >&2
            return 1
            ;;
    esac
}

# Main dispatch

# Resolve help before ticket store initialization.
if [[ "${1:-}" == "help" ]]; then
    shift
    help_args=()
    for arg in "$@"; do
        [[ "$arg" == "--help" || "$arg" == "-h" ]] && continue
        help_args+=("$arg")
    done
    cmd_help "${help_args[@]}"
    exit $?
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    if [[ $# -ne 1 ]]; then
        print_argument_error help "Unexpected argument: ${2}"
        exit 1
    fi
    cmd_help
    exit 0
fi

# Reject unknown commands before help dispatch or ticket-store discovery.
case "${1:-}" in
    ""|init|create|start|close|reopen|status|dep|undep|ls|list|tree|ready|blocked|done|closed|prune|delete|show|add-note) ;;
    *)
        printf 'Unknown command: %s\n' "$1" >&2
        cmd_help >&2
        exit 1
        ;;
esac

# A help flag anywhere after a known command takes precedence over work.
help_requested=0
for arg in "${@:2}"; do
    [[ "$arg" == "--" ]] && break
    if [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
        help_requested=1
        break
    fi
done

if [[ $help_requested -eq 1 ]]; then
    if [[ "${1:-}" == "dep" && "${2:-}" == "tree" ]]; then
        cmd_help dep tree
    else
        cmd_help "${1:-help}"
    fi
    exit $?
fi

# Initialize tickets dir for built-in commands (skip for help)
case "${1:-help}" in
    help|--help|-h) ;;
    *) init_tickets_dir "$@" || exit 1 ;;
esac

# Built-in commands
case "${1:-help}" in
    init)   shift; cmd_init "$@" ;;
    create) shift; cmd_create "$@" ;;
    start)  shift; cmd_start "$@" ;;
    close)  shift; cmd_close "$@" ;;
    reopen) shift; cmd_reopen "$@" ;;
    status) shift; cmd_status "$@" ;;
    dep)    shift; cmd_dep "$@" ;;
    undep)  shift; cmd_undep "$@" ;;
    ls|list) shift; cmd_ls "$@" ;;
    tree)   shift; cmd_tree "$@" ;;
    ready)  shift; cmd_ready "$@" ;;
    blocked) shift; cmd_blocked "$@" ;;
    done)   shift; cmd_done "$@" ;;
    closed) shift; cmd_closed "$@" ;;
    prune)  shift; cmd_prune "$@" ;;
    delete) shift; cmd_delete "$@" ;;
    show)   shift; cmd_show "$@" ;;
    add-note) shift; cmd_add_note "$@" ;;
    help) shift; cmd_help "$@" ;;
    --help|-h) cmd_help ;;
    *)
        printf 'Unknown command: %s\n' "$1" >&2
        cmd_help >&2
        exit 1
        ;;
esac
