cmd_closed() {
    local limit=20
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --limit=*)
                limit="${1#--limit=}"
                if [[ -z "$limit" ]]; then
                    echo "Error: --limit requires a value" >&2
                    print_usage closed >&2
                    return 1
                fi
                validate_positive_int "--limit" "$limit" || return 1
                shift
                ;;
            --limit)
                if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                    echo "Error: --limit requires a value" >&2
                    print_usage closed >&2
                    return 1
                fi
                limit="$2"
                validate_positive_int "--limit" "$limit" || return 1
                shift 2
                ;;
            -*)
                print_argument_error closed "Unknown option: $1"
                return 1
                ;;
            *)
                print_argument_error closed "Unexpected argument: $1"
                return 1
                ;;
        esac
    done

    load_ticket_files
    [[ ${#TICKET_FILES[@]} -eq 0 ]] && return 0

    local file status sorted
    local -a closed_files=() files=()
    for file in "${TICKET_FILES[@]}"; do
        [[ -f "$file" && ! -L "$file" ]] || continue
        status=$(yaml_field "$file" "status")
        [[ "$status" == "closed" ]] && closed_files+=("$file")
    done
    [[ ${#closed_files[@]} -eq 0 ]] && return 0

    sorted=$(ls -t -- "${closed_files[@]}") || return 1
    mapfile -t files <<< "$sorted"

    awk -v limit="$limit" '
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) emit()
        id=""; status=""; title=""; in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && /^---$/ { in_front = 1; next }
    in_front && /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function emit() {
        if (id != "" && status == "closed" && count < limit) {
            printf "%-8s [%s] - %s\n", id, status, title
            count++
        }
    }
    END { if (prev_file) emit() }
    ' "${files[@]}"
}

ticket_outgoing_refs() {
    local file="$1"
    local parent deps dep_id

    parent=$(yaml_field "$file" "parent")
    [[ -n "$parent" ]] && printf '%s\n' "$parent"

    deps=$(yaml_field "$file" "deps")
    deps="${deps#[}"
    deps="${deps%]}"
    deps="${deps// /}"
    [[ -z "$deps" ]] && return 0

    local -a dep_ids
    IFS=',' read -r -a dep_ids <<< "$deps"
    for dep_id in "${dep_ids[@]}"; do
        [[ -n "$dep_id" ]] && printf '%s\n' "$dep_id"
    done
}

cmd_prune() {
    if [[ $# -gt 0 ]]; then
        if [[ "$1" == -* ]]; then
            print_argument_error prune "Unknown option: $1"
        else
            print_argument_error prune "Unexpected argument: $1"
        fi
        return 1
    fi

    acquire_store_lock || return 1
    load_ticket_files
    [[ ${#TICKET_FILES[@]} -eq 0 ]] && {
        echo "No closed tickets to prune"
        return 0
    }

    local -A file_by_id=() reachable=()
    local -a closed_ids=() queue=()
    local file id status current ref_id
    local head=0 count=0 retained=0

    for file in "${TICKET_FILES[@]}"; do
        id=$(basename "$file" .md)
        status=$(yaml_field "$file" "status")
        file_by_id["$id"]="$file"
        if [[ "$status" == "closed" ]]; then
            closed_ids+=("$id")
        else
            queue+=("$id")
        fi
    done

    [[ ${#closed_ids[@]} -eq 0 ]] && {
        echo "No closed tickets to prune"
        return 0
    }

    while [[ $head -lt ${#queue[@]} ]]; do
        current="${queue[$head]}"
        ((head += 1))

        [[ -n "${reachable[$current]:-}" ]] && continue
        reachable["$current"]=1

        file="${file_by_id[$current]:-}"
        [[ -z "$file" ]] && continue

        while IFS= read -r ref_id; do
            [[ -z "$ref_id" || -z "${file_by_id[$ref_id]:-}" || -n "${reachable[$ref_id]:-}" ]] && continue
            queue+=("$ref_id")
        done < <(ticket_outgoing_refs "$file")
    done

    for id in "${closed_ids[@]}"; do
        if [[ -n "${reachable[$id]:-}" ]]; then
            echo "Retained $id (still reachable from non-closed tickets)"
            ((retained += 1))
            continue
        fi

        rm -f "${file_by_id[$id]}"
        echo "Pruned $id"
        ((count += 1))
    done

    [[ $count -gt 0 ]] && echo "Pruned $count ticket(s)"
    [[ $retained -gt 0 ]] && echo "Retained $retained closed ticket(s) still reachable from non-closed tickets"
    return 0
}

