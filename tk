#!/usr/bin/env bash
set -euo pipefail

# ticket - minimal ticket system with dependency tracking
# Stores markdown files with YAML frontmatter in .tickets/

# Find .tickets directory by walking parent directories
find_tickets_dir() {
    # Explicit env var takes priority
    [[ -n "${TICKETS_DIR:-}" ]] && { echo "$TICKETS_DIR"; return 0; }

    # Walk parents looking for .tickets
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.tickets" ]]; then
            echo "$dir/.tickets"
            return 0
        fi
        dir=$(dirname "$dir")
    done

    # Check root too
    [[ -d "/.tickets" ]] && { echo "/.tickets"; return 0; }

    # Not found
    return 1
}

# Commands that can create .tickets if not found
WRITE_COMMANDS="create init"

# Queue-summary commands should be safe probes in repositories that do not
# have a ticket store yet.
MISSING_STORE_OK_COMMANDS="ls list tree ready blocked closed done"

# Initialize TICKETS_DIR based on command type
init_tickets_dir() {
    local cmd="${1:-}"
    local is_write_cmd=0 allow_missing_store=0
    [[ " $WRITE_COMMANDS " == *" $cmd "* ]] && is_write_cmd=1
    [[ " $MISSING_STORE_OK_COMMANDS " == *" $cmd "* ]] && allow_missing_store=1
    [[ "$cmd" == "dep" && "${2:-}" == "tree" ]] && allow_missing_store=1

    if TICKETS_DIR=$(find_tickets_dir); then
        # For read commands, verify the directory exists
        if [[ $is_write_cmd -eq 0 ]] && [[ ! -d "$TICKETS_DIR" ]]; then
            echo "Error: tickets directory '$TICKETS_DIR' does not exist" >&2
            return 1
        fi
        return 0
    fi

    # Not found - write commands can initialize in current directory
    if [[ $is_write_cmd -eq 1 ]]; then
        TICKETS_DIR=".tickets"
        return 0
    fi

    # Queue-summary commands are allowed to behave like an empty ticket store.
    if [[ $allow_missing_store -eq 1 ]]; then
        TICKETS_DIR=".tickets"
        return 0
    fi

    echo "Error: no .tickets directory found (searched parent directories)" >&2
    echo "Run 'tk init' or 'tk create' to initialize, or set TICKETS_DIR env var" >&2
    return 1
}

TICKET_PAGER="${TICKET_PAGER:-${PAGER:-}}"

# Prefer ripgrep if available, fall back to grep
if command -v rg &>/dev/null; then
    _grep() { rg "$@"; }
else
    _grep() { grep "$@"; }
fi

# Portable ISO date (GNU date supports -Iseconds, BSD date does not)
_iso_date() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

# Generate a random ticket ID
generate_id() {
    local hash
    hash=$(LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom | head -c 6 || true)
    if [[ ! "$hash" =~ ^[a-z0-9]{6}$ ]]; then
        echo "Error: failed to generate a ticket ID" >&2
        return 1
    fi
    printf '%s\n' "$hash"
}

# Ensure tickets directory exists
ensure_dir() {
    mkdir -p "$TICKETS_DIR"
}

STORE_LOCK_HELD=0
STORE_LOCK_PATH=""
STORE_LOCK_TOKEN=""
STORE_LAST_TEMP=""
STORE_TEMP_FILES=()

release_store_lock() {
    [[ $STORE_LOCK_HELD -eq 1 ]] || return 0
    local current=""
    [[ -f "$STORE_LOCK_PATH" && ! -L "$STORE_LOCK_PATH" ]] && current=$(<"$STORE_LOCK_PATH")
    if [[ "$current" == "$STORE_LOCK_TOKEN" ]]; then
        rm -f "$STORE_LOCK_PATH"
    fi
    STORE_LOCK_HELD=0
}

cleanup_store_state() {
    local tmp
    for tmp in "${STORE_TEMP_FILES[@]}"; do
        [[ -e "$tmp" || -L "$tmp" ]] && rm -f "$tmp"
    done
    release_store_lock
}

process_identity() {
    local pid="$1"
    local started
    started=$(LC_ALL=C ps -p "$pid" -o lstart= 2>/dev/null) || return 1
    read -r started <<< "$started"
    [[ -n "$started" ]] || return 1
    printf '%s:%s\n' "$pid" "$started"
}

lock_owner_is_alive() {
    local token="$1"
    local pid="${token%%:*}"
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    [[ "$(process_identity "$pid" 2>/dev/null || true)" == "$token" ]]
}

reap_stale_store_lock() {
    local expected_owner="$1"
    local reaper="$STORE_LOCK_PATH.reaper"

    # Only one process may reap a stale lock. A leftover reaper blocks
    # automatic recovery rather than risking removal of a new live lock.
    mkdir "$reaper" 2>/dev/null || return 0
    if [[ -L "$reaper" || ! -d "$reaper" ]]; then
        return 0
    fi

    local current_owner=""
    [[ -f "$STORE_LOCK_PATH" && ! -L "$STORE_LOCK_PATH" ]] && current_owner=$(<"$STORE_LOCK_PATH")
    if [[ "$current_owner" == "$expected_owner" ]] && ! lock_owner_is_alive "$current_owner"; then
        rm -f "$STORE_LOCK_PATH"
    fi
    rmdir "$reaper" 2>/dev/null || true
}

acquire_store_lock() {
    ensure_dir
    STORE_LOCK_PATH="$TICKETS_DIR/.lock"
    STORE_LOCK_TOKEN=$(process_identity "$$") || {
        echo "Error: could not determine lock owner" >&2
        return 1
    }

    local attempt owner
    for ((attempt = 0; attempt <= 21; attempt++)); do
        if (set -o noclobber; printf '%s\n' "$STORE_LOCK_TOKEN" > "$STORE_LOCK_PATH") 2>/dev/null; then
            if ! chmod 644 "$STORE_LOCK_PATH"; then
                rm -f "$STORE_LOCK_PATH"
                echo "Error: could not initialize ticket-store lock" >&2
                return 1
            fi
            STORE_LOCK_HELD=1
            trap cleanup_store_state EXIT
            trap 'exit 129' HUP
            trap 'exit 130' INT
            trap 'exit 143' TERM
            return 0
        fi

        if [[ ! -e "$STORE_LOCK_PATH" && ! -L "$STORE_LOCK_PATH" ]]; then
            continue
        fi
        if [[ ! -f "$STORE_LOCK_PATH" || -L "$STORE_LOCK_PATH" ]]; then
            echo "Error: invalid ticket-store lock" >&2
            return 1
        fi

        owner=$(<"$STORE_LOCK_PATH")
        if [[ -n "$owner" ]] && ! lock_owner_is_alive "$owner"; then
            reap_stale_store_lock "$owner"
            [[ ! -e "$STORE_LOCK_PATH" ]] && continue
        elif [[ -z "$owner" && $attempt -eq 20 ]]; then
            reap_stale_store_lock "$owner"
            [[ ! -e "$STORE_LOCK_PATH" ]] && continue
        fi

        [[ $attempt -ge 20 ]] && break
        sleep 0.05
    done

    echo "Error: ticket store is busy; retry the command" >&2
    return 1
}

new_store_temp() {
    STORE_LAST_TEMP=$(mktemp "$TICKETS_DIR/.tk.tmp.XXXXXX") || return 1
    chmod 600 "$STORE_LAST_TEMP"
    STORE_TEMP_FILES+=("$STORE_LAST_TEMP")
}

prepare_rewrite_temp() {
    local file="$1"
    new_store_temp || return 1
    if ! cat "$file" > "$STORE_LAST_TEMP"; then
        rm -f "$STORE_LAST_TEMP"
        return 1
    fi
}

ticket_file_mode() {
    local file="$1"
    if stat -c %a "$file" >/dev/null 2>&1; then
        stat -c %a "$file"
    else
        stat -f %Lp "$file"
    fi
}

preserve_ticket_mode() {
    local source="$1"
    local target="$2"
    chmod "$(ticket_file_mode "$source")" "$target"
}

set_new_ticket_mode() {
    local file="$1"
    local mask mode
    mask=$(umask)
    mode=$((0666 & ~0$mask))
    printf -v mode '%03o' "$mode"
    chmod "$mode" "$file"
}

load_ticket_files() {
    shopt -s nullglob
    local -a candidates=("$TICKETS_DIR"/*.md)
    shopt -u nullglob

    TICKET_FILES=()
    local file
    for file in "${candidates[@]}"; do
        [[ -f "$file" && ! -L "$file" ]] && TICKET_FILES+=("$file")
    done
    return 0
}

validate_id_fragment() {
    local id="$1"
    if [[ ! "$id" =~ ^[a-z0-9]{1,6}$ ]]; then
        printf "Error: invalid ticket ID '%s'. Use 1-6 lowercase letters or digits\n" "$id" >&2
        return 1
    fi
}

# Get a direct ticket file path (supports literal partial ID matching).
ticket_path() {
    local id="$1"
    # Trim leading/trailing whitespace (handles agent-generated whitespace).
    read -r id <<< "$id"
    validate_id_fragment "$id" || return 1

    local exact="$TICKETS_DIR/${id}.md"
    if [[ -L "$exact" ]]; then
        printf "Error: ticket '%s' is a symbolic link\n" "$id" >&2
        return 1
    fi
    if [[ -f "$exact" ]]; then
        printf '%s\n' "$exact"
        return 0
    fi

    local file candidate
    local -a matches=()
    load_ticket_files
    for file in "${TICKET_FILES[@]}"; do
        [[ -f "$file" && ! -L "$file" ]] || continue
        candidate=$(basename "$file" .md)
        [[ "$candidate" == *"$id"* ]] && matches+=("$file")
        [[ ${#matches[@]} -gt 1 ]] && break
    done

    if [[ ${#matches[@]} -eq 1 ]]; then
        printf '%s\n' "${matches[0]}"
    elif [[ ${#matches[@]} -gt 1 ]]; then
        printf "Error: ambiguous ID '%s' matches multiple tickets\n" "$id" >&2
        return 1
    else
        printf "Error: ticket '%s' not found\n" "$id" >&2
        return 1
    fi
}

# Extract YAML field value
yaml_field() {
    local file="$1"
    local field="$2"
    awk -v field="$field" '
        NR == 1 && /^---$/ { in_front = 1; next }
        in_front && /^---$/ { exit }
        in_front && index($0, field ":") == 1 {
            sub("^[^:]+: *", "", $0)
            print
            exit
        }
    ' "$file"
}

# Update a YAML field through an atomic, permission-preserving replacement.
update_yaml_field() {
    local file="$1"
    local field="$2"
    local value="$3"
    local tmp
    prepare_rewrite_temp "$file" || return 1
    tmp="$STORE_LAST_TEMP"

    if ! awk -v field="$field" -v value="$value" '
        NR == 1 && /^---$/ {
            in_front = 1
            print
            next
        }
        in_front && /^---$/ {
            if (!updated) print field ": " value
            in_front = 0
            print
            next
        }
        in_front && index($0, field ":") == 1 {
            if (!updated) print field ": " value
            updated = 1
            next
        }
        { print }
    ' "$file" > "$tmp"; then
        return 1
    fi
    preserve_ticket_mode "$file" "$tmp"
    mv "$tmp" "$file"
}

array_contains() {
    local list="$1"
    local item="$2"
    local value

    list="${list#[}"
    list="${list%]}"
    list="${list// /}"
    [[ -z "$list" ]] && return 1

    local -a values
    IFS=',' read -r -a values <<< "$list"
    for value in "${values[@]}"; do
        [[ "$value" == "$item" ]] && return 0
    done
    return 1
}

array_append() {
    local list="$1"
    local item="$2"

    if [[ "$list" == "[]" || -z "${list// }" ]]; then
        echo "[$item]"
    else
        echo "${list%]}, $item]"
    fi
}

array_remove() {
    local list="$1"
    local item="$2"
    local value out=""

    list="${list#[}"
    list="${list%]}"
    list="${list// /}"
    [[ -z "$list" ]] && {
        echo "[]"
        return 0
    }

    local -a values
    IFS=',' read -r -a values <<< "$list"
    for value in "${values[@]}"; do
        [[ -z "$value" || "$value" == "$item" ]] && continue
        if [[ -z "$out" ]]; then
            out="$value"
        else
            out="$out, $value"
        fi
    done

    [[ -z "$out" ]] && echo "[]" || echo "[$out]"
}

ticket_references() {
    local target="$1"

    load_ticket_files
    [[ ${#TICKET_FILES[@]} -eq 0 ]] && return 0

    awk -v target="$target" '
        BEGIN { FS=": "; in_front=0 }
        FNR==1 {
            if (prev_file) store()
            id=""; parent=""; deps=""; in_front=0
            prev_file=FILENAME
        }
        FNR == 1 && /^---$/ { in_front = 1; next }
        in_front && /^---$/ { in_front = 0; next }
        in_front && /^id:/ { id = $2 }
        in_front && /^parent:/ { parent = $2 }
        in_front && /^deps:/ {
            deps = $2
            gsub(/[\[\] ]/, "", deps)
        }
        function store(    i, n, dep) {
            if (id == "") return
            if (parent == target) printf "parent:%s\n", id
            if (deps != "") {
                n = split(deps, arr, ",")
                for (i = 1; i <= n; i++) {
                    dep = arr[i]
                    if (dep == target) printf "dep:%s\n", id
                }
            }
        }
        END {
            if (prev_file) store()
        }
    ' "${TICKET_FILES[@]}"
}

format_references() {
    local refs="$1"
    local ref out=""

    while IFS= read -r ref; do
        [[ -z "$ref" ]] && continue
        case "$ref" in
            dep:*)
                [[ -n "$out" ]] && out+="; "
                out+="dependency of ${ref#dep:}"
                ;;
            parent:*)
                [[ -n "$out" ]] && out+="; "
                out+="parent of ${ref#parent:}"
                ;;
        esac
    done <<< "$refs"

    printf '%s' "$out"
}

require_option_value() {
    local option="$1"
    local value="${2:-}"

    if [[ -z "$value" ]]; then
        echo "Error: $option requires a value" >&2
        return 1
    fi

    case "$value" in
        -) ;;
        -*)
            echo "Error: $option requires a value" >&2
            return 1
            ;;
    esac
}

validate_priority() {
    local priority="$1"
    [[ "$priority" =~ ^[0-4]$ ]] && return 0

    echo "Error: invalid priority '$priority'. Must be an integer from 0 to 4" >&2
    return 1
}

validate_positive_int() {
    local option="$1"
    local value="$2"
    [[ "$value" =~ ^[1-9][0-9]*$ ]] && return 0

    echo "Error: invalid $option '$value'. Must be a positive integer" >&2
    return 1
}

print_usage() {
    local topic="$1"
    local cmd
    cmd=$(basename "$0")

    case "$topic" in
        init)     echo "Usage: $cmd init [--tracked]" ;;
        create)   echo "Usage: $cmd create [title] [options]" ;;
        start)    echo "Usage: $cmd start <id>" ;;
        close)    echo "Usage: $cmd close <id>" ;;
        reopen)   echo "Usage: $cmd reopen <id>" ;;
        status)   echo "Usage: $cmd status <id> <status>" ;;
        dep)      echo "Usage: $cmd dep <id> <dependency-id>" ;;
        dep-tree) echo "Usage: $cmd dep tree [--full] [id]" ;;
        undep)    echo "Usage: $cmd undep <id> <dependency-id>" ;;
        list)     echo "Usage: $cmd list [--status <status>]..." ;;
        tree)     echo "Usage: $cmd tree [id]" ;;
        ready)    echo "Usage: $cmd ready" ;;
        blocked)  echo "Usage: $cmd blocked" ;;
        done)     echo "Usage: $cmd done" ;;
        closed)   echo "Usage: $cmd closed [--limit <number>]" ;;
        prune)    echo "Usage: $cmd prune" ;;
        delete)   echo "Usage: $cmd delete <id>" ;;
        show)     echo "Usage: $cmd show <id>" ;;
        add-note) echo "Usage: $cmd add-note <id> [note text]" ;;
        help)     echo "Usage: $cmd help [command [subcommand]]" ;;
        *)        return 1 ;;
    esac
}

print_argument_error() {
    local topic="$1"
    local message="$2"
    echo "$message" >&2
    print_usage "$topic" >&2
}

cmd_init() {
    local tracked=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tracked)
                tracked=1
                shift
                ;;
            -*)
                print_argument_error init "Unknown option: $1"
                return 1
                ;;
            *)
                print_argument_error init "Unexpected argument: $1"
                return 1
                ;;
        esac
    done

    acquire_store_lock || return 1
    echo "Initialized $TICKETS_DIR"

    if [[ $tracked -eq 1 ]]; then
        echo "Leaving tickets trackable by git"
        return 0
    fi

    if [[ "$(basename "$TICKETS_DIR")" != ".tickets" ]]; then
        echo "Skipped .gitignore update for custom TICKETS_DIR"
        return 0
    fi

    local base_dir gitignore
    base_dir=$(cd "$(dirname "$TICKETS_DIR")" && pwd)
    gitignore="$base_dir/.gitignore"

    if [[ -f "$gitignore" ]] && grep -Eq '^[[:space:]]*/?\.tickets/?[[:space:]]*$' "$gitignore"; then
        echo ".tickets/ already ignored in $gitignore"
        return 0
    fi

    if [[ -f "$gitignore" && -s "$gitignore" ]]; then
        if [[ "$(tail -c 1 "$gitignore" 2>/dev/null || true)" != "" ]]; then
            printf '\n' >> "$gitignore"
        fi
        printf '.tickets/\n' >> "$gitignore"
    else
        printf '.tickets/\n' > "$gitignore"
    fi

    echo "Ignored .tickets/ in $gitignore"
}

cmd_create() {
    local title="" description=""
    local priority=2 parent=""
    local title_set=0

    # Parse and validate all arguments before creating the ticket store.
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d=*|--description=*)
                description="${1#*=}"
                if [[ -z "$description" ]]; then
                    echo "Error: ${1%%=*} requires a value" >&2
                    print_usage create >&2
                    return 1
                fi
                shift
                ;;
            -d|--description)
                require_option_value "$1" "${2:-}" || { print_usage create >&2; return 1; }
                if [[ "$2" == "-" ]]; then
                    description=$(cat)
                else
                    description="$2"
                fi
                shift 2
                ;;
            -p|--priority)
                require_option_value "$1" "${2:-}" || { print_usage create >&2; return 1; }
                priority="$2"
                shift 2
                ;;
            --parent)
                require_option_value "$1" "${2:-}" || { print_usage create >&2; return 1; }
                parent="$2"
                shift 2
                ;;
            --)
                shift
                if [[ $title_set -eq 1 || $# -ne 1 ]]; then
                    print_argument_error create "Expected one title after --"
                    return 1
                fi
                title="$1"
                title_set=1
                shift
                ;;
            -*)
                print_argument_error create "Unknown option: $1"
                return 1
                ;;
            *)
                if [[ $title_set -eq 1 ]]; then
                    print_argument_error create "Unexpected argument: $1"
                    return 1
                fi
                title="$1"
                title_set=1
                shift
                ;;
        esac
    done

    validate_priority "$priority" || { print_usage create >&2; return 1; }

    if [[ -n "$parent" && ! -d "$TICKETS_DIR" ]]; then
        echo "Error: ticket '$parent' not found" >&2
        return 1
    fi
    acquire_store_lock || return 1

    # Resolve the parent while the store is locked.
    if [[ -n "$parent" ]]; then
        local parent_file
        parent_file=$(ticket_path "$parent") || return 1
        parent=$(basename "$parent_file" .md)
    fi

    title="${title:-Untitled}"
    local id file
    local attempts=0
    while true; do
        id=$(generate_id)
        file="$TICKETS_DIR/${id}.md"
        [[ ! -e "$file" && ! -L "$file" ]] && break

        attempts=$((attempts + 1))
        if [[ $attempts -ge 100 ]]; then
            echo "Error: failed to generate a unique ticket ID after 100 attempts" >&2
            return 1
        fi
    done

    local now tmp
    now=$(_iso_date)
    new_store_temp || return 1
    tmp="$STORE_LAST_TEMP"

    {
        printf '%s\n' '---'
        printf 'id: %s\n' "$id"
        printf '%s\n' 'status: open' 'deps: []'
        printf 'created: %s\n' "$now"
        printf 'priority: %s\n' "$priority"
        [[ -n "$parent" ]] && printf 'parent: %s\n' "$parent"
        printf '%s\n' '---'
        printf '# %s\n\n' "$title"
        [[ -n "$description" ]] && printf '%s\n\n' "$description"
    } > "$tmp"
    set_new_ticket_mode "$tmp"
    mv "$tmp" "$file"

    printf '%s\n' "$id"
}

# Valid statuses
VALID_STATUSES="open in_progress closed"

validate_status() {
    local status="$1"
    for valid in $VALID_STATUSES; do
        [[ "$status" == "$valid" ]] && return 0
    done
    echo "Error: invalid status '$status'. Must be one of: $VALID_STATUSES" >&2
    return 1
}

cmd_status() {
    if [[ $# -ne 2 ]]; then
        print_usage status >&2
        echo "Valid statuses: $VALID_STATUSES" >&2
        return 1
    fi
    if [[ "$1" == -* || "$2" == -* ]]; then
        local invalid_arg="$1"
        [[ "$2" == -* ]] && invalid_arg="$2"
        print_argument_error status "Unknown option: $invalid_arg"
        return 1
    fi

    local id="$1"
    local status="$2"

    validate_status "$status" || return 1
    acquire_store_lock || return 1

    local file current_status resolved_id
    file=$(ticket_path "$id") || return 1
    resolved_id=$(basename "$file" .md)
    current_status=$(yaml_field "$file" "status")

    if [[ "$current_status" == "$status" ]]; then
        echo "Ticket $resolved_id is already $status"
        return 0
    fi

    update_yaml_field "$file" "status" "$status"
    echo "Updated $resolved_id -> $status"
}

cmd_start() {
    if [[ $# -ne 1 ]]; then
        print_usage start >&2
        return 1
    fi
    if [[ "$1" == -* ]]; then
        print_argument_error start "Unknown option: $1"
        return 1
    fi
    cmd_status "$1" "in_progress"
}

cmd_close() {
    if [[ $# -ne 1 ]]; then
        print_usage close >&2
        return 1
    fi
    if [[ "$1" == -* ]]; then
        print_argument_error close "Unknown option: $1"
        return 1
    fi
    cmd_status "$1" "closed"
}

cmd_reopen() {
    if [[ $# -ne 1 ]]; then
        print_usage reopen >&2
        return 1
    fi
    if [[ "$1" == -* ]]; then
        print_argument_error reopen "Unknown option: $1"
        return 1
    fi
    cmd_status "$1" "open"
}

cmd_dep_tree() {
    local full_mode=0
    local root_id=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full) full_mode=1; shift ;;
            -*)
                print_argument_error dep-tree "Unknown option: $1"
                return 1
                ;;
            *)
                if [[ -n "$root_id" ]]; then
                    print_argument_error dep-tree "Unexpected argument: $1"
                    return 1
                fi
                root_id="$1"
                shift
                ;;
        esac
    done

    if [[ -n "$root_id" ]]; then
        local root_file
        root_file=$(ticket_path "$root_id") || return 1
        root_id=$(basename "$root_file" .md)
    fi

    load_ticket_files
    [[ ${#TICKET_FILES[@]} -eq 0 ]] && return 0

    awk -v root_id="$root_id" -v full_mode="$full_mode" '
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; deps=""; in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && /^---$/ { in_front = 1; next }
    in_front && /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^deps:/ {
        deps = $2
        gsub(/[\[\] ]/, "", deps)
    }
    !in_front && /^# / && title == "" { title = substr($0, 3) }

    function store(    i, n) {
        if (id != "") {
            statuses[id] = status
            titles[id] = title
            deps_raw[id] = deps
            n = split(deps, arr, ",")
            for (i = 1; i <= n; i++) if (arr[i] != "") {
                dep_count[id]++
                dep_list[id, dep_count[id]] = arr[i]
                reverse_count[arr[i]]++
            }
        }
    }

    function sort_values(arr, n,    i, j, tmp) {
        for (i = 2; i <= n; i++) {
            tmp = arr[i]
            j = i - 1
            while (j >= 1 && arr[j] > tmp) {
                arr[j + 1] = arr[j]
                j--
            }
            arr[j + 1] = tmp
        }
    }

    function print_node(id, prefix, connector, is_last, path,    i, n, child, arr, child_prefix) {
        if (!(id in statuses)) return

        if (index(path, ":" id ":") > 0) {
            printf "%s%s%-8s [%s] - %s (cycle)\n", prefix, connector, id, statuses[id], titles[id]
            return
        }

        if (!full_mode && (id in printed)) {
            printf "%s%s%-8s [%s] - %s (shared)\n", prefix, connector, id, statuses[id], titles[id]
            return
        }

        printf "%s%s%-8s [%s] - %s\n", prefix, connector, id, statuses[id], titles[id]
        rendered[id] = 1
        if (!full_mode) printed[id] = 1

        n = 0
        for (i = 1; i <= dep_count[id]; i++) {
            child = dep_list[id, i]
            if (child in statuses) arr[++n] = child
        }
        if (n == 0) return

        sort_values(arr, n)
        child_prefix = prefix
        if (connector != "") child_prefix = prefix (is_last ? "    " : "│   ")
        path = path id ":"

        for (i = 1; i <= n; i++) {
            print_node(arr[i], child_prefix, (i == n ? "└── " : "├── "), i == n, path)
        }
    }

    END {
        if (prev_file) store()

        if (root_id != "") {
            print_node(root_id, "", "", 1, ":")
            exit
        }

        root_count = 0
        for (id in statuses) {
            if (!(id in reverse_count)) roots[++root_count] = id
        }
        sort_values(roots, root_count)

        for (i = 1; i <= root_count; i++) {
            print_node(roots[i], "", "", 1, ":")
        }

        extra_count = 0
        for (id in statuses) {
            if (!(id in rendered)) extras[++extra_count] = id
        }
        sort_values(extras, extra_count)
        for (i = 1; i <= extra_count; i++) {
            if (!(extras[i] in rendered)) print_node(extras[i], "", "", 1, ":")
        }
    }
    ' "${TICKET_FILES[@]}"
}

cmd_dep() {
    # Handle subcommands
    if [[ "${1:-}" == "tree" ]]; then
        shift
        cmd_dep_tree "$@"
        return
    fi

    if [[ $# -ne 2 ]]; then
        print_usage dep >&2
        echo "       $(basename "$0") dep tree [--full] [id]" >&2
        return 1
    fi
    if [[ "$1" == -* || "$2" == -* ]]; then
        local invalid_arg="$1"
        [[ "$2" == -* ]] && invalid_arg="$2"
        print_argument_error dep "Unknown option: $invalid_arg"
        return 1
    fi

    local id="$1"
    local dep_id="$2"
    acquire_store_lock || return 1

    local file
    file=$(ticket_path "$id") || return 1

    # Verify dependency exists and resolve to full ID
    local dep_file
    dep_file=$(ticket_path "$dep_id") || return 1
    dep_id=$(basename "$dep_file" .md)

    if [[ "$(basename "$file" .md)" == "$dep_id" ]]; then
        echo "Error: a ticket cannot depend on itself" >&2
        return 1
    fi

    # Get current deps
    local current_deps
    current_deps=$(yaml_field "$file" "deps")

    # Add dep if not already present
    if array_contains "$current_deps" "$dep_id"; then
        echo "Dependency already exists"
        return 0
    fi

    update_yaml_field "$file" "deps" "$(array_append "$current_deps" "$dep_id")"

    echo "Added dependency: $(basename "$file" .md) -> $dep_id"
}

cmd_ls() {
    local status_filter="" status_value
    while [[ $# -gt 0 ]]; do
        case "$1" in
